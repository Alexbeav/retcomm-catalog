{
  "id": "galerians-psx",
  "name": "Galerians",
  "kind": "recomp",
  "platform": "psx",
  "description": "A recompilation setup kit for Galerians.",
  "homepage": "https://github.com/Alexbeav/galerians-recomp",
  "author_notes": "Supply the complete listed Redump CUE/BIN set and your own SCPH5552 (Europe) BIOS dump; the kit itself also accepts a CHD of the same dump, but Retro matches CUE/BIN only. First-run setup generates and compiles the game on your machine and also builds a diagnostic variant: create an empty diagnostic-mode.txt next to the setup executable (or run it with --diagnostic) to use it, and --collect-diagnostics zips the runtime's report files for a GitHub issue. Netplay is not qualified. Native Linux and macOS owned-input setup and gameplay remain unverified. Setup starts with Disc 1; later discs are selected when the game requests them, and disc transitions during play are not qualified by this packet.",
  "notes": "Wave 4 v0.1.0 owned-input setup release. Source fallback is pinned to the exact public commit that produced the release assets. Windows: exact-package clean-extract setup, generation, compilation and headless start checks passed on the release pin; play testing of the private builds this kit derives from is recorded in the title README. Native Linux/macOS owned-input setup and gameplay remain unverified. The single macos glob matches both the arm64 and the x64 setup zip.",
  "install_dir_name": "galerians-recomp",
  "launch": {
    "linux": "Galerians",
    "windows": "Galerians.exe",
    "macos": "Galerians"
  },
  "release": {
    "github": "Alexbeav/galerians-recomp",
    "asset_glob": {
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip",
      "windows": "*windows-x64.zip"
    }
  },
  "build": {
    "enabled": true,
    "source": {
      "github": "Alexbeav/galerians-recomp",
      "ref": "5ca1a0a9e0bbb2139b96b6b89b4a7bdbb07ce221"
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "macos": "*cmake-clang-v1*macos*",
        "windows": "*cmake-clang-v1*windows*"
      },
      "min_version": "1.0.3"
    }
  },
