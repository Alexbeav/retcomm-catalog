{
  "id": "armored-core-master-of-arena-psx",
  "name": "Armored Core: Master of Arena",
  "kind": "recomp",
  "platform": "psx",
  "description": "A recompilation setup kit for Armored Core: Master of Arena.",
  "homepage": "https://github.com/Alexbeav/armored-core-master-of-arena-recomp",
  "author_notes": "Supply the complete listed Redump CUE/BIN set and your own SCPH1001 (USA) BIOS dump; the kit itself also accepts a CHD of the same dump, but Retro matches CUE/BIN only. First-run setup generates and compiles the game on your machine and also builds a diagnostic variant: create an empty diagnostic-mode.txt next to the setup executable (or run it with --diagnostic) to use it, and --collect-diagnostics zips the runtime's report files for a GitHub issue. Netplay is not qualified. Native Linux and macOS owned-input setup and gameplay remain unverified. Setup starts with Disc 1; later discs are selected when the game requests them, and disc transitions during play are not qualified by this packet. A seam artifact reported in play testing is under separate investigation.",
  "notes": "Wave 4 v0.1.0 owned-input setup release. Source fallback is pinned to the exact public commit that produced the release assets. Windows: exact-package clean-extract setup, generation, compilation and headless start checks passed on the release pin; play testing of the private builds this kit derives from is recorded in the title README. Native Linux/macOS owned-input setup and gameplay remain unverified. The single macos glob matches both the arm64 and the x64 setup zip.",
  "install_dir_name": "armored-core-master-of-arena-recomp",
  "launch": {
    "linux": "Armored_Core_Master_of_Arena",
    "windows": "Armored_Core_Master_of_Arena.exe",
    "macos": "Armored_Core_Master_of_Arena"
  },
  "release": {
    "github": "Alexbeav/armored-core-master-of-arena-recomp",
    "asset_glob": {
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip",
      "windows": "*windows-x64.zip"
    }
  },
  "build": {
    "enabled": true,
    "source": {
      "github": "Alexbeav/armored-core-master-of-arena-recomp",
      "ref": "d39c6cbae60acb545d52f99ad0b4509cf8ea3d5c"
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "macos": "*cmake-clang-v1*macos*",
        "windows": "*cmake-clang-v1*windows*"
      },
      "min_version": "1.0.3"
    }
  },
